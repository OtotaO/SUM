{
  "name": "sum-demo-worker",
  "description": "Cloudflare Worker serving the SUM hosted demo. Static assets + /api/complete + /api/qid.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:sign": "node --experimental-strip-types test/sign_smoke.mjs",
    "test:density": "node --experimental-strip-types test/density_smoke.mjs",
    "test:rate-limit": "node --experimental-strip-types --test test/rate_limit.test.mjs",
    "tail": "wrangler tail",
    "test:hardening": "node --experimental-strip-types --test test/hardening.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20260828.0-alpha"
  },
  "dependencies": {
    "canonicalize": "^4.0.0",
    "jose": "^6.2.10"
  }
}
